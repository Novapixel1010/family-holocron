# Copy to .env and adjust. Every setting is optional.

# Port on the host that serves Family Holocron.
HOLOCRON_HOST_PORT=8080

# Version label baked into the image (shown in Settings → General).
HOLOCRON_VERSION=dev

# Set to true when serving over HTTPS (e.g. behind Caddy/Traefik/nginx) so the
# session cookie is marked Secure.
HOLOCRON_SECURE_COOKIES=false

# Maximum size of a single media upload, in MiB. Backup uploads may be larger.
HOLOCRON_MAX_UPLOAD_MB=64

# How long sign-in sessions last, in hours (default 30 days).
HOLOCRON_SESSION_TTL_HOURS=720

# Where stored backups are written inside the container (default: <data dir>/backups,
# i.e. on the data volume).
# HOLOCRON_BACKUP_DIR=/var/opt/holocron/data/backups

# Comma-separated plugin ids to force off (e.g. "stats").
# HOLOCRON_DISABLED_PLUGINS=

# Verbose request logging.
HOLOCRON_DEV=false
